extends ../../layouts/default.pug

block main
  .container.my-5
    h1.mb-4 Phiên đã thắng

    .alert.alert-info.card-white
      strong Mã người đấu giá:
      |  #{bidderCode}

    if orders.length > 0
      each order in orders
        .card.mb-4
          .card-body
            h4.mb-3 #{order.auctionSnapshot && order.auctionSnapshot.title ? order.auctionSnapshot.title : "Phiên đấu giá"}

            p
              strong Mã thanh toán:
              |  #{order.id}

            p
              strong Giá thắng:
              |  #{order.totalPrice.toLocaleString("vi-VN")}đ

            p
              strong Phương thức:
              if order.paymentMethod === "crypto"
                span.badge.badge-warning.ml-2 USDT
              else
                span.badge.badge-info.ml-2 COD

            p
              strong Trạng thái:
              if order.status == "pending"
                span.text-warning  Chờ xử lý
              else if order.status == "paid"
                span.text-success  Đã thanh toán
              else if order.status == "confirmed"
                span.text-info  Đã xác nhận
              else if order.status == "shipping"
                span.text-primary  Đang giao
              else if order.status == "done"
                span.text-success  Hoàn thành
              else if order.status == "cancel"
                span.text-danger  Đã hủy
              else
                span  #{order.status}

            a.btn.btn-sm.btn-info.mr-2(href=`/orders/detail/${order.id}`) Chi tiết
            if order.paymentMethod === "crypto" && order.status === "pending"
              a.btn.btn-sm.btn-warning(href=`/checkout/crypto-payment/${order.id}`) Thanh toán USDT
    else
      .alert.alert-info Bạn chưa thắng phiên đấu giá nào.
