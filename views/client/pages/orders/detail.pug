extends ../../layouts/default.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-10
        .card.mb-4
          .card-body
            h2.mb-4 Chi tiết phiên thắng

            p
              strong Mã thanh toán:
              |  #{order.id}

            p
              strong Phiên:
              |  #{order.auctionSnapshot && order.auctionSnapshot.title ? order.auctionSnapshot.title : "Phiên đấu giá"}

            p
              strong Giá thắng:
              |  #{order.totalPrice.toLocaleString("vi-VN")}đ

            p
              strong Người nhận:
              |  #{order.customerInfo.fullName}

            p
              strong Số điện thoại:
              |  #{order.customerInfo.phone}

            p
              strong Địa chỉ:
              |  #{order.customerInfo.address}

            p
              strong Trạng thái:
              |  #{order.status}

            if order.paymentMethod === "crypto"
              p
                strong Số USDT cần chuyển:
                |  #{order.exact_amount}

            .mt-4
              a.btn.btn-secondary(href="/orders") Quay lại
