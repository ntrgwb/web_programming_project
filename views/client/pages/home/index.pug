extends ../../layouts/default.pug

block main
  .container
    .hero-section.text-center.mt-5.mb-5.pt-5
      h1.title-home.glitch-text NullAuction
      p.lead.text-light.mt-3.mb-5 Đấu giá ẩn danh. Không tài khoản. Mỗi lượt đặt được gắn với một mã phiên riêng.
      a.btn.btn-custom-neon.btn-lg(href="/products") >_ VÀO PHIÊN ĐẤU GIÁ

    .row.mt-5.pt-4
      .col-md-4.mb-4
        .cyber-card.text-center
          h4.text-info Mã Ẩn Danh
          p.text-muted Người đấu giá được nhận mã phiên tự động, không cần email hoặc tài khoản.

      .col-md-4.mb-4
        .cyber-card.text-center
          h4.text-info Đặt Giá Công Khai
          p.text-muted Lịch sử giá được hiển thị minh bạch, danh tính người đặt được rút gọn.

      .col-md-4.mb-4
        .cyber-card.text-center
          h4.text-info Thanh Toán Sau Khi Thắng
          p.text-muted Người thắng mới cần tạo thông tin nhận hàng và chọn phương thức thanh toán.

    .row.mt-5
      .col-md-10.offset-md-1
        .terminal-box
          .terminal-header
            span.dot.bg-danger
            span.dot.bg-warning
            span.dot.bg-success
            span.terminal-title root@anonymous-auction:~
          .terminal-body
            p.text-success >_ QUY TRÌNH ĐẤU GIÁ ẨN DANH:
            p.text-light [1] Chọn một phiên đấu giá đang mở.
            p.text-light [2] Đặt giá bằng mã ẩn danh do hệ thống cấp trong session.
            p.text-light [3] Khi phiên kết thúc, người dẫn giá có thể tạo thanh toán.
            p.text-danger [!] Hãy lưu lại mã người đấu giá nếu cần đối chiếu trong cùng trình duyệt.
            p.text-success >_
              span.blink-cursor █

    .row.mt-5.mb-5
      .col-md-10.offset-md-1
        .warning-box.text-center
          strong.text-danger [ LƯU Ý ]
          span.text-muted  Phiên đấu giá dựa trên session trình duyệt. Xóa cookie/session có thể làm mất khả năng xác nhận người thắng.