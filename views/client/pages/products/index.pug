extends ../../layouts/default.pug
include ../../mixins/.box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head("Danh sách phiên đấu giá")

    if messages.success
      .alert.alert-success
        each item in messages.success
          div= item

    if messages.error
      .alert.alert-danger
        each item in messages.error
          div= item

    .alert.alert-info.card-white
      strong Mã người đấu giá:
      |  #{bidderCode}

    if products.length > 0
      .row
        each item in products
          .col-md-4.mb-3
            .product-item.auction-item
              .inner-image
                img(
                  src=item.thumbnail || "/images/no-image.png"
                  alt=item.title
                )
              .inner-content
                h3.inner-title
                  a(href=`/products/${item.slug}`) #{item.title}

                .mb-2
                  if item.auctionState === "live"
                    span.badge.badge-success Đang đấu giá
                  else if item.auctionState === "upcoming"
                    span.badge.badge-info Sắp bắt đầu
                  else if item.auctionState === "ended"
                    span.badge.badge-secondary Đã kết thúc
                  else
                    span.badge.badge-warning #{item.auctionState}

                .inner-price-new #{item.currentPrice.toLocaleString("vi-VN")}đ
                .auction-line Giá khởi điểm: #{item.startingPrice.toLocaleString("vi-VN")}đ
                .auction-line Bước giá: #{item.bidStep.toLocaleString("vi-VN")}đ
                .auction-line Lượt đặt: #{item.bidCount || 0}

                if item.auctionEndAt
                  .auction-line Kết thúc: #{formatDateShort(item.auctionEndAt)}

                a.btn.btn-outline-info.w-100.mt-3(href=`/products/${item.slug}`)
                  if item.isLive
                    | Đặt giá
                  else
                    | Xem phiên
    else
      .alert.alert-info Chưa có phiên đấu giá nào.
