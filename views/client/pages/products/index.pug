extends ../../layouts/default.pug 
include ../../mixins/.box-head.pug

block main
  .container.my-3
    .row
      .col-12
        +box-head("Danh Sách Sản Phẩm")

    .row
      each item in products
        .col-4.mb-3
          .product-item
            .inner-image
              img(
                src=item.thumbnail
                alt=item.title
              )
            .inner-content
                h3.inner-title
                  a(href=`/products/${item.slug}`) #{item.title}

                .inner-price-new #{item.priceNew}đ  
                .inner-price-old #{item.price}đ
                .inner-discount -#{item.discountPercentage}đ

                form(action=`/cart/add/${item.id}` method="POST")
                  input(type="hidden" name="quantity" value="1")
                  .row.mt-2
                    .col-6.pr-1
                      //- Dùng type="button" và class "btn-add-to-cart" để JS bắt lấy nó, không cho chuyển trang
                      button.btn.btn-outline-info.w-100.btn-add-to-cart(type="button" title="Thêm vào giỏ hàng")
                        //- Nếu bạn có FontAwesome thì dùng dòng dưới, không thì thay bằng chữ "Thêm"
                        i.fa-solid.fa-cart-plus
                          | Thêm vào giỏ
                        
                    .col-6.pl-1
                      button.btn.btn-outline-info.w-100(type="submit") 
                        i.fa-solid.fa-bolt.mr-1
                          | Mua ngay