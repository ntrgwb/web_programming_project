extends ../../layouts/default.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-6
        .card.shadow-sm.border-0.text-center
          .card-body.p-4
            h3.mb-4 Thanh toán bằng USDT (TRC20)
            
            .alert.alert-warning.p-3
              p.mb-1.font-weight-bold Vui lòng chuyển chính xác số tiền dưới đây:
              h2.text-danger.font-weight-bold.mb-0 #{order.exact_amount} USDT
            
            .my-4
              p.text-muted Địa chỉ ví nhận tiền:
              .p-2.bg-light.border.rounded.font-weight-bold.text-break
                | TV9fTvNQh8gaWofEAFnUAdCpZXZR62baRk
            
            .text-muted.small.mt-3
              p * Hệ thống tự động kiểm tra giao dịch mỗi phút một lần.
              p * Đơn hàng sẽ tự chuyển sang trạng thái "Đã thanh toán" sau khi nhận đủ tiền.

            a.btn.btn-secondary.mt-3(href="/orders") Xem lịch sử đơn hàng