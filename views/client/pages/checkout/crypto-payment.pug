extends ../../layouts/default.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-6
        .card.shadow-sm.border-0.text-center
          .card-body.p-4
            h3.mb-4 Thanh toán phiên thắng bằng USDT (TRC20)

            p.font-weight-bold.mb-1 #{order.auctionSnapshot && order.auctionSnapshot.title ? order.auctionSnapshot.title : "Phiên đấu giá"}

            .alert.alert-warning.p-3
              p.mb-1.font-weight-bold Vui lòng chuyển chính xác số tiền:
              h2.text-danger.font-weight-bold.mb-0 #{order.exact_amount} USDT

            .my-4
              p.text-muted Địa chỉ ví nhận tiền:
              .p-2.bg-light.border.rounded.font-weight-bold.text-break
                | TV9fTvNQh8gaWofEAFnUAdCpZXZR62baRk

            .text-muted.small.mt-3
              p Hệ thống đối soát giao dịch theo số USDT chính xác.
              p Sau khi nhận đủ tiền, trạng thái sẽ chuyển sang đã thanh toán.

            a.btn.btn-secondary.mt-3(href="/orders") Xem phiên đã thắng
