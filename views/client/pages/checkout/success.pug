extends ../../layouts/default.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-8
        .card
          .card-body
            h1.text-success.mb-4 Đã ghi nhận thanh toán
            p Thanh toán cho phiên thắng đã được tạo.

            hr

            p
              strong Phiên:
              |  #{order.auctionSnapshot && order.auctionSnapshot.title ? order.auctionSnapshot.title : "Phiên đấu giá"}

            p
              strong Giá thắng:
              |  #{order.totalPrice.toLocaleString("vi-VN")}đ

            p
              strong Người nhận:
              |  #{order.customerInfo.fullName}

            p
              strong Số điện thoại:
              |  #{order.customerInfo.phone}

            p
              strong Địa chỉ:
              |  #{order.customerInfo.address}

            p
              strong Trạng thái:
              |  #{order.status}

            .mt-4
              a.btn.btn-primary.mr-2(href="/products") Xem phiên khác
              a.btn.btn-info(href="/orders") Phiên đã thắng
