extends ../../layout/default 

block main
  h2(style="text-align:center") Chat với Khách Hàng

  #chat-container(style="width:500px;margin:auto;border:1px solid #ccc;padding:10px;border-radius:10px")

    #chat-box(style="height:400px;overflow-y:scroll;border:1px solid #ddd;padding:10px;margin-bottom:10px;border-radius:10px")
      each msg in messages
        if msg.role === "admin"
          div(style="text-align:right;margin:5px")
            span(style="font-size:12px;color:#888") Admin
            br
            span(style="background:#2196F3;color:white;padding:5px 10px;border-radius:10px;display:inline-block")
              | #{msg.content}
        else
          div(style="text-align:left;margin:5px")
            span(style="font-size:12px;color:#888") User
            br
            span(style="background:#eee;padding:5px 10px;border-radius:10px;display:inline-block")
              | #{msg.content}

    form(action="/admin/chat/send" method="POST" style="display:flex;gap:5px")
      input(
        type="text"
        name="content"
        placeholder="Nhập phản hồi..."
        required
        autocomplete="off"
        style="flex:1;padding:5px"
      )
      button(type="submit") Gửi

  script.
    window.onload = () => {
      const box = document.getElementById("chat-box");
      box.scrollTop = box.scrollHeight;
    };