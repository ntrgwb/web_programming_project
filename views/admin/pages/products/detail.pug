extends ../../layout/default.pug

block main
  h1.mb-4 #{product.title}

  .card.mb-4
    .card-body
      if product.thumbnail
        img.mb-3(src=product.thumbnail, style="width: 160px")

      p
        strong Giá khởi điểm:
        |  #{product.startingPrice.toLocaleString("vi-VN")}đ

      p
        strong Giá hiện tại:
        |  #{product.currentPrice.toLocaleString("vi-VN")}đ

      p
        strong Bước giá:
        |  #{product.bidStep.toLocaleString("vi-VN")}đ

      p
        strong Lượt đặt:
        |  #{product.bidCount || 0}

      p
        strong Trạng thái phiên:
        |  #{product.auctionState}

      if product.highestBidderCode
        p
          strong Người đang dẫn:
          |  #{product.highestBidderCode}

      if product.auctionStartAt
        p
          strong Bắt đầu:
          |  #{formatDateShort(product.auctionStartAt)}

      if product.auctionEndAt
        p
          strong Kết thúc:
          |  #{formatDateShort(product.auctionEndAt)}

      if product.description
        .mt-3!= product.description

      a.btn.btn-warning(href=`${prefixAdmin}/products/edit/${product.id}`) Chỉnh sửa

  h3 Lịch sử đặt giá
  if bids.length > 0
    table.table.table-bordered
      thead
        tr
          th Người đặt
          th Giá đặt
          th Thời gian
      tbody
        each bid in bids
          tr
            td #{bid.bidderCode}
            td #{bid.amount.toLocaleString("vi-VN")}đ
            td #{formatDateShort(bid.createdAt)}
  else
    .alert.alert-info Chưa có lượt đặt giá nào.
