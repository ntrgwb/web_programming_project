extends ../../layout/default.pug

include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug

block main
  +alert-success(5000)

  h1 Danh sách phiên đấu giá

  .card.mb-3
    .card-header Bộ lọc và tìm kiếm
    .card-body
      .row
        .col-6
          +filter-status(filterStatus)
        .col-6
          +search(keyword)

  .card.mb-3
    .card-header Sắp xếp
    .card-body
      .row
        .col-4
          +sort()

  .card.mb-3
    .card-header Cập nhật phiên đấu giá
    .card-body
      .row
        .col-8
          +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)
        .col-4.text-right
          a.btn.btn-outline-success(href=`${prefixAdmin}/products/create`) + Tạo phiên đấu giá

    table.table.table-hover.table-sm(checkbox-multi)
      thead
        tr
          th
            input(type="checkbox" name="checkall")
          th STT
          th Ảnh
          th Tiêu đề
          th Giá hiện tại
          th Bước giá
          th Lượt đặt
          th Kết thúc
          th Trạng thái
          th Hành động
      tbody
        each item, index in products
          tr
            td
              input(type="checkbox" name="ids" value=item.id)
            td #{pagination.limitItems * (pagination.currentPage - 1) + (index + 1)}
            td
              img(src=item.thumbnail, alt=item.title, width="100px", height="auto")
            td #{item.title}
            td #{item.currentPrice.toLocaleString("vi-VN")}đ
            td #{item.bidStep.toLocaleString("vi-VN")}đ
            td #{item.bidCount || 0}
            td
              if item.auctionEndAt
                | #{formatDateShort(item.auctionEndAt)}
              else
                span.text-muted Chưa đặt
            td
              if item.status === "active"
                a.badge.badge-success(href="javascript:;" data-status=item.status data-id=item.id button-change-status) Hoạt động
              else
                a.badge.badge-danger(href="javascript:;" data-status=item.status data-id=item.id button-change-status) Dừng
              br
              span.badge.badge-secondary.mt-1 #{item.auctionState}
            td
              a.btn.btn-secondary.btn-sm(href=`${prefixAdmin}/products/detail/${item.id}`) Chi tiết
              a.btn.btn-warning.btn-sm(href=`${prefixAdmin}/products/edit/${item.id}`) Sửa
              button.btn.btn-danger.btn-sm(button-delete data-id=item.id) Xóa

  +pagination(pagination)

  form(action="" method="POST" id="form-change-status" data-path=`${prefixAdmin}/products/change-status`)

  form(action="" method="POST" id="form-delete-item" data-path=`${prefixAdmin}/products/delete`)

  script(src="/admin/js/products.js")
