extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)
  +alert-success(5000)

  h1.mb-4 Cập nhật phiên đấu giá

  form(action=`${prefixAdmin}/products/edit/${product.id}?_method=PATCH` id="form-edit-product" method="POST" enctype="multipart/form-data")
    .form-group
      label(for="title") Tiêu đề
      input.form-control(type="text" id="title" name="title" required value=product.title)

    .form-group
      label(for="desc") Mô tả
      textarea.form-control(id="desc" name="description" rows="5" required) #{product.description}

    .form-group
      label(for="startingPrice") Giá khởi điểm
      input.form-control(type="number" id="startingPrice" name="startingPrice" min="0" required value=product.startingPrice)

    .form-group
      label(for="currentPrice") Giá hiện tại
      input.form-control(type="number" id="currentPrice" name="currentPrice" min="0" value=product.currentPrice disabled=(product.bidCount > 0))
      if product.bidCount > 0
        small.text-muted Không chỉnh giá hiện tại sau khi đã có lượt đặt.

    .form-group
      label(for="bidStep") Bước giá tối thiểu
      input.form-control(type="number" id="bidStep" name="bidStep" min="1" value=product.bidStep required)

    .form-group
      label(for="auctionStartAt") Thời gian bắt đầu
      input.form-control(type="datetime-local" id="auctionStartAt" name="auctionStartAt" value=formatDateTimeInput(product.auctionStartAt))

    .form-group
      label(for="auctionEndAt") Thời gian kết thúc
      input.form-control(type="datetime-local" id="auctionEndAt" name="auctionEndAt" value=formatDateTimeInput(product.auctionEndAt))

    .form-group
      label(for="auctionStatus") Trạng thái phiên
      select.form-control(id="auctionStatus" name="auctionStatus")
        option(value="live" selected=(product.auctionStatus === "live")) Đang mở
        option(value="draft" selected=(product.auctionStatus === "draft")) Nháp
        option(value="cancelled" selected=(product.auctionStatus === "cancelled")) Đã hủy

    .form-group(upload-image)
      label(for="thumbnail") Ảnh
      input.form-control-file(type="file" id="thumbnail" name="thumbnail" accept="image/*" upload-image-input)
      img.image-preview(src=product.thumbnail upload-image-preview)

    .form-group
      label(for="position") Vị trí
      input.form-control(type="number" id="position" name="position" placeholder="Tự động tăng" min="1" value=product.position)

    .form-group
      label Trạng thái hiển thị
      div
        input(type="radio" id="active" name="status" value="active" checked=(product.status == "active"))
        label.mr-3(for="active") Hoạt động
        input(type="radio" id="inactive" name="status" value="inactive" checked=(product.status == "inactive"))
        label(for="inactive") Dừng

    button.btn.btn-primary.mt-3(type="submit") Cập nhật

  script(src="/admin/js/script.js")
