extends ../../layout/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)

  h1.mb-4 Tạo phiên đấu giá

  form(action=`${prefixAdmin}/products/create` id="form-create-product" method="POST" enctype="multipart/form-data")
    .form-group
      label(for="title") Tiêu đề
      input.form-control(type="text" id="title" name="title" required)

    .form-group
      label(for="desc") Mô tả
      textarea.form-control.textarea-mce(id="desc" name="description" rows="5" required)

    .form-group
      label(for="startingPrice") Giá khởi điểm
      input.form-control(type="number" id="startingPrice" name="startingPrice" min="0" value="0" required)

    .form-group
      label(for="bidStep") Bước giá tối thiểu
      input.form-control(type="number" id="bidStep" name="bidStep" min="1" value="10000" required)

    .form-group
      label(for="auctionStartAt") Thời gian bắt đầu
      input.form-control(type="datetime-local" id="auctionStartAt" name="auctionStartAt")

    .form-group
      label(for="auctionEndAt") Thời gian kết thúc
      input.form-control(type="datetime-local" id="auctionEndAt" name="auctionEndAt")

    .form-group
      label(for="auctionStatus") Trạng thái phiên
      select.form-control(id="auctionStatus" name="auctionStatus")
        option(value="live" selected) Đang mở
        option(value="draft") Nháp
        option(value="cancelled") Đã hủy

    .form-group(upload-image)
      label(for="thumbnail") Ảnh
      input.form-control-file(type="file" id="thumbnail" name="thumbnail" accept="image/*" upload-image-input)
      img.image-preview(src="" upload-image-preview)

    .form-group
      label(for="position") Vị trí
      input.form-control(type="number" id="position" name="position" placeholder="Tự động tăng" min="1")

    .form-group
      label Trạng thái hiển thị
      div
        input(type="radio" id="active" name="status" value="active" checked)
        label.mr-3(for="active") Hoạt động
        input(type="radio" id="inactive" name="status" value="inactive")
        label(for="inactive") Dừng

    button.btn.btn-primary.mt-3(type="submit") Tạo phiên

  script(src="/admin/js/script.js")
