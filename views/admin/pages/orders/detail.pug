extends ../../layout/default.pug

block main
  .container-fluid.mt-4
    h2.mb-4 Chi tiết thanh toán phiên thắng

    .card.mb-4
      .card-header
        strong Thông tin phiên
      .card-body
        p
          strong Phiên:
          |  #{order.auctionSnapshot && order.auctionSnapshot.title ? order.auctionSnapshot.title : "Phiên đấu giá"}
        p
          strong Người thắng:
          |  #{order.bidderCode || "-"}
        p
          strong Giá thắng:
          |  #{order.totalPrice.toLocaleString("vi-VN")}đ
        p
          strong Trạng thái:
          |  #{order.status}
        if order.paymentMethod === "crypto"
          p
            strong Số USDT:
            |  #{order.exact_amount}
          if order.tx_id
            p
              strong TxID:
              |  #{order.tx_id}

    .card
      .card-header
        strong Thông tin người nhận
      .card-body
        p
          strong Họ tên:
          |  #{order.customerInfo.fullName}
        p
          strong Số điện thoại:
          |  #{order.customerInfo.phone}
        p
          strong Địa chỉ:
          |  #{order.customerInfo.address}
