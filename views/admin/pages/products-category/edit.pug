extends ../../layout/default.pug
include ../../mixins/alert.pug

mixin category-options(items, selectedParentId, level = 1)
  each item in items
    - const prefix = Array(level + 1).join("-- ")
    option(value=item.id selected=(item.id === selectedParentId)) #{prefix}#{item.title}
    if item.children && item.children.length > 0
      +category-options(item.children, selectedParentId, level + 1)

block main
  +alert-error(5000)
  +alert-success(5000)

  h1.mb-4 Cập nhật danh mục tài sản đấu giá

  form(action=`${prefixAdmin}/product-category/edit/${record.id}?_method=PATCH` method="POST" enctype="multipart/form-data")
    .form-group
      label(for="title") Tiêu đề
      input.form-control(type="text" id="title" name="title" required value=record.title)

    .form-group
      label(for="parent_id") Danh mục cha
      select.form-control(name="parent_id" id="parent_id")
        option(value="" selected=(record.parent_id === "")) -- Không có danh mục cha --
        if records
          +category-options(records, record.parent_id)

    .form-group
      label(for="desc") Mô tả
      textarea.form-control.textarea-mce(id="desc" name="description" rows="5" required) #{record.description}

    .form-group(upload-image)
      label(for="thumbnail") Ảnh
      input.form-control-file(type="file" id="thumbnail" name="thumbnail" accept="image/*" upload-image-input)
      img.image-preview(src=record.thumbnail upload-image-preview)

    .form-group
      label(for="position") Vị trí
      input.form-control(type="number" id="position" name="position" min="1" value=record.position)

    .form-group
      label Trạng thái
      div
        input(type="radio" id="active" name="status" value="active" checked=(record.status === "active"))
        label.mr-3(for="active") Hoạt động
        input(type="radio" id="inactive" name="status" value="inactive" checked=(record.status === "inactive"))
        label(for="inactive") Dừng

    button.btn.btn-primary.mt-3(type="submit") Cập nhật

  script(src="/admin/js/script.js")
